/*******************************
Theme overrides by valery
*******************************/
.marron {
    color: @marron;
}

a {
    color: @primaryColor;
}

.text-primary {
    color: @primaryColor;
}

h2 {
    font-weight: 600;
    color: @primaryColor;
}

