         #header {
            z-index:0;
        }
        .ui.dropdown .menu {
            z-index: 2 !important;
        }
        .ui.menu.menu-principal .ui.dropdown .menu > .item {
            padding:0.3125em 1.125em !important;
        }
        .ui.secondary.menu.site-top-header {
            background: #008c6c; /* Old browsers */
            background: -moz-linear-gradient(left, #008c6c 0%, #0672b9 100%); /* FF3.6-15 */
            background: -webkit-linear-gradient(left, #008c6c 0%,#0672b9 100%); /* Chrome10-25,Safari5.1-6 */
            background: linear-gradient(to right, #008c6c 0%,#0672b9 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
            filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#008c6c', endColorstr='#0672b9',GradientType=1 ); /* IE6-9 */
            margin-bottom : 0;
        }
        .ui.main.menu {
            margin: 0;
            background : rgba(240,240,240,0.70);
            display:block;
        }
        .ui.main.menu .item {
            color:#3F5F85;
        }
        .ui.main.menu.menu-principal {
            position: relative;
            z-index: 2;
        }
        .ui.main.menu.menu-principal .menu.right {
            background : none;
            border: none;
            -webkit-box-shadow: none;
            box-shadow: none;
            border-radius: 0;
        }
        .social-menu > a {
            display: inline-block;
            height: 23px;
            width: 23px;
            margin-top:10px;
            margin-left: 6px;
            text-indent : -9999em;
            transition: all .2s ease-in-out;
        }
        .social-menu > a:hover {
         transform: scale(1.2);
     }
     .v-facebook {
        background : url('/workspace/img/facebook-logo.png') center center no-repeat;
    }
    .v-vimeo {
        background : url('/workspace/img/vimeo-social-logo.png') center center no-repeat;
    }
    .v-flickr {
        background : url('/workspace/img/flickr-logo.png') center center no-repeat;
    }
    .v-instagram {
        background : url('/workspace/img/instagram-logo.png') center center no-repeat;
    }
    .site-name {
        font-size:2.3em;
        color:#E8FAFD;
    }
    .site-baseline {
        font-family : "Open Sans", helvetica, arial, sans-serif;
        font-size: 1.3em;
        font-weight : 600;
        font-style: italic;
        color:#E8FAFD;
    }
    .site-top-header img.ui {
        border : 3px solid white;
    }
    .site-top-header .ui.button {
        background : rgba(255,255,255,0.71);
        color:#517364;
    }
    .hero {
        position: relative;
        margin-top: -46px;
        max-height: 86%;
        z-index: 0;
        background-repeat: no-repeat;
    }

    .hero .hero-slogan {
        min-height:430px;
        padding-top:120px;
        padding-bottom: 45px;
    }
    .hero h1 {
        font-size: 2.1em;
        color : white;
        text-shadow: 1px 2px 3px grey
    }
    section.annonce h1 {
        font-size: 2.3em;
    }
    section.annonce {
        background-image: url(/workspace/img/actu-newsletter-1920.png);
        background-size: 100% 100%;
        z-index: 3;
        position: relative;
        padding: 8em 0;
        color: white;
    }
    section.actu-newsletter {
        position: relative;
        min-height:450px;
        background-color: #E8FAFD;
        margin-top : -50px;
        padding-top: 6em;
        padding-bottom: 8em;
    }
    section.actu-newsletter h2 {
        margin-bottom:0;
    }
    section.actu-newsletter .ui.basic.button {
        border: none;
        -webkit-box-shadow:none !important;
        -moz-box-shadow:none !important;
        box-shadow:none !important;
    }
    section.actu-newsletter .newsletterTextBlock {
        padding: 50px !important;
        background-color: white;
        font-size: 18px;
    }
    section.actu-newsletter .newsletterTextBlock a {
        color: @marron;
        font-weight: bold;
    }
    section.actu-newsletter .ui.cards > .card {
        box-shadow: 0px 1px 8px 2px #b5d8de;
    }
    section.actu-newsletter .ui.cards > .card > .image {
        // height:130px;
        // overflow:hidden;
    }
    section.reserves {
        background-image: url(/workspace/img/fond-reserves-blanc.png), url(/workspace/img/fond-reserves.png);
        background-size: 70% 100%, 97% 100%;
        position: relative;
        margin-top: -4em;
        min-height: 22em;
        background-position: right top,left 13px;
        background-repeat: no-repeat, no-repeat;
        margin-bottom: Opx;
        padding-bottom:3em;
    }
    section.reserves .title {
        padding-top:6em;
    }
    section.reserves #carte-rb {
        width: 90%;
        padding-top:0;
        padding-right:3em;
    }
    h2.osibv {
        font-size: 3.2em;
        font-style: italic;
        font-weight: bold;
        color: #249A86;
        line-height: 1.4em;
        padding-right: 25px;
    }
    h2.osliv {
        font-size: 2em;
        font-weight: 300;
        font-style: italic;
        color: #249A86;
        line-height: 2.6em;
    }
    .list-rb > a {
        font-size: 0.8em;
        margin-bottom: 5px;
        padding: 6px 15px !important;
        background: #ffffffb0;
    }
    .list-rb > a.item:hover .header,
    .list-rb > a.item:hover .icon,
    .list-rb > a.item.hovered .header,
    .list-rb > a.item.hovered .icon {
        color:#B1563D !important;
    }
    // breadcrumbs
    .bkg-breadcrumb {
        background : rgba(255,255,255,0.6);
        height: 2.2em;
        width:100%;
    }
    .ui.breadcrumb {
        padding: 0.7em 1em 0em 1.2em;
        font-size: 0.8em !important;
        display:block !important;
        color: @blue;
    }
    .page-header {
        background : url('/workspace/img/fond-page-contenus.png') center bottom no-repeat;
        min-height:8em;
        padding-top:0 !important;
        margin-bottom:3em;
    }
    .page-header h1 {
        padding-left: 0.5em;
        font-weight: bold;
    }
    // contents
    .home .main-content {
        margin-top:45px;
    }
    .main-content {
        margin-top:16px;
    }
    #content {
        color:#262727;
    }
    #content a {
        text-decoration : underline;
    }
    #content.ui.segment {
        border: none;
        box-shadow: none;
    }
    #content strong {
        color:#094851;
        font-weight:bold;
    }
    #content h1, #content h2, #content h3 {
        font-family : @fontName, helvetica, arial, sans-serif;
        color:@marron;
    }
    #content ul {
        list-style-type: inherit;
        padding: 0 0 0 2.2em;
    }
    section.contact {
        background : url(/workspace/img/fond-section-contact.jpg) 100% 100% no-repeat;
        padding-top:3em;
        padding-bottom:6em;
    }
    .main.container {
        font-family : "Open Sans", helvetica, arial, sans-serif;
        margin-right:387px !important;
        margin-left: 3em !important;
        width: 700px !important;
        max-width:960px !important;
    }
    .ui.sticky.bound.top, .ui.sticky.fixed.top {
        top: 45px;
        bottom: auto;
    }
    section.menu-footer ul.ui.list {
        margin-left:0px;
    }
    section.menu-footer ul.ui.list ul {
        padding:0  0 0.25em 0.5em;
    }
    section.menu-footer ul.ui.list li:before,
    section.menu-footer .ui.bulleted.list .list > .item:before,
    section.menu-footer .ui.bulleted.list > .item:before {
        content:'';
    }

    section.footer {
        background-color: #C96B4D;
        padding:2em 0;
        color:white;
    }
    section.footer .ui.list > a.item {
        color:white;
    }

    #tocContents {
        background-image: url(/workspace/img/fond-page-contenus.png);
        background-repeat: no-repeat;
        background-position: bottom right;
        background-size: auto 100%;
        padding: 10px 0 41px 5px;
    }
/*
 * jquery.tocify.css 1.9.0
 * Author: @gregfranko
 */
 /* The Table of Contents container element */
 #content .tocify {
    font-family : "Open Sans", helvetica, arial, sans-serif;
    padding-top:1em;
    height:130%;
}
#content .tocify a {
    text-decoration : none;
}
#content .tocify a:hover {
    text-decoration: underline;
}
#content .tocify a:before {
    font-family: Icons;
    content: "\f30b";
    padding-right:5px;
}
/* The Table of Contents is composed of multiple nested unordered lists.  These styles remove the default styling of an unordered list because it is ugly. */
#content .tocify ul, #content .tocify li {
    list-style: none;
    margin: 0 0 6px 0;
    padding: 0px 10px 0 8px;
    border: none;
    line-height: 15px;
}
#content .tocify ul {
    margin-top:6px;
}
/* Top level header elements */
.tocify-header {
    text-indent: 0px;
}

/* Top level subheader elements.  These are the first nested items underneath a header element. */
.tocify-subheader {
    padding-left: 6px;
    /*display: none;*/
}

/* Makes the font smaller for all subheader elements. */
.tocify-subheader li {
    font-size: 12px;
}

/* Further indents second level subheader elements. */
.tocify-subheader .tocify-subheader {
    text-indent: 30px;
}

/* Further indents third level subheader elements. You can continue this pattern if you have more nested elements. */
.tocify-subheader .tocify-subheader .tocify-subheader {
    text-indent: 40px;
}


// responsive media query
@media screen and (min-width: 1200px) {
    .main.ui.container {
        max-width:880px !important;
        width:860px !important;
        margin-left:10% !important;
    }
}
@media screen and (min-width: 1280px) {
    .hero {
        background-image:url('/workspace/img/slogan.jpg');
        max-height: 67%;
    }
    section.annonce {
        margin-top:-7em;
    }
}
@media screen and (max-width: 1280px) {
    .hero {
        background-image:url('/workspace/img/slogan-1280.png');
        background-position: center -4px;
    }
    section.annonce {
        margin-top:-8%;
    }
}