@headerFont			 : "Open Sans", helvetica, sans-serif;
@fontSize			 : 16px;
@headerFontWeight	 : 400;
@fontWeight          : 400;
@paragraphLineHeight : 24px;
@primaryColor        : #3F5F85;
@secondaryColor      : #008C6C;
